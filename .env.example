# Base de datos local
DB_URL=jdbc:mysql://joya:3306/joya?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Argentina/Buenos_Aires
DB_USER_NAME=usuario_mysql
DB_PASSWORD=reemplazar-con-contrasena-segura
MYSQL_USER=usuario_mysql
MYSQL_PASSWORD=reemplazar-con-contrasena-segura
MYSQL_ROOT_PASSWORD=reemplazar-con-contrasena-root-segura
MYSQL_DATABASE=joya

# Usuarios iniciales del sistema
ADMIN_USER=admin
ADMIN_PASS=cambiar-clave-admin
EMPLEADO_USER=empleado
EMPLEADO_PASS=cambiar-clave-empleado

# URL publica HTTPS del sistema (necesaria para enviar fotos)
PUBLIC_BASE_URL=https://stock.ejemplo.com

# Aplicacion OAuth de Mercado Libre compartida por la instalacion.
# Cada negocio conecta su propia cuenta y sus tokens se guardan cifrados en MySQL.
ML_CLIENT_ID=123456789
ML_CLIENT_SECRET=reemplazar
# Respaldo opcional solamente para el tenant principal:
ML_ACCESS_TOKEN=APP_USR-reemplazar
ML_REFRESH_TOKEN=TG-reemplazar
ML_SITE_ID=MLA
MERCADOLIBRE_REDIRECT_URI=https://stock.ejemplo.com/canales/mercadolibre/callback

# Clave Base64 de 32 bytes para cifrar tokens en MySQL. No cambiarla luego.
INTEGRATIONS_ENCRYPTION_KEY=reemplazar-con-clave-base64

# Secreto compartido para validar webhooks de WooCommerce y Tiendanube.
# Puede generarse con: openssl rand -base64 32
INTEGRATIONS_WEBHOOK_SECRET=reemplazar-con-secreto-aleatorio

# Publicacion de Mercado Libre
MERCADOLIBRE_CATEGORY_ID=MLA-reemplazar
MERCADOLIBRE_LISTING_TYPE_ID=gold_special
MERCADOLIBRE_USER_PRODUCTS=true

# Cada negocio conecta su propia cuenta de WooCommerce desde Canales de venta.
TN_STORE_ID=
TN_ACCESS_TOKEN=
TN_USER_AGENT=SistemaStock/1.0
TN_CLIENT_ID=
TN_CLIENT_SECRET=
TIENDANUBE_REDIRECT_URI=https://stock.ejemplo.com/canales/tiendanube/callback
